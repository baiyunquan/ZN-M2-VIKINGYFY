#!/bin/sh

. /lib/functions.sh

case "$ACTION" in
pressed)
	[ -z "$SEEN" ] && SEEN=0
	;;
timeout)
	;;
released)
	if [ "$SEEN" -ge 5 ]; then
		logger -t "button-reset" "Reset button pressed for $SEEN seconds: Switching to stock firmware (rootfs)..."
		echo "FACTORY FALLBACK: Switching to stock firmware (rootfs)..." > /dev/console
		if [ -x /sbin/dualboot ]; then
			/sbin/dualboot stock
		fi
		sync
		reboot &
	elif [ "$SEEN" -ge 1 ]; then
		logger -t "button-reset" "Reset button pressed for $SEEN seconds: Rebooting router..."
		echo "REBOOT" > /dev/console
		sync
		reboot &
	fi
	;;
esac

return 0
